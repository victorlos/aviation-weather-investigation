[0m04:52:09.017747 [debug] [Thread-2 (]: On model.aviation_weather.fact_flights_weather_delay: /* {"app": "dbt", "dbt_version": "1.9.4", "profile_name": "aviation_weather", "target_name": "dev", "node_id": "model.aviation_weather.fact_flights_weather_delay"} */
create or replace transient table AVIATION_WEATHER_PROJECT.DEV.fact_flights_weather_delay
         as
        (SELECT 
    ff.flightdate,
    ff.carrier_name,
    ff.originairportid,
    ff.destairportid,
    ff.arrdelay,
    ff.weatherdelay,
    da_orig.display_airport_name orig_airport_name,
    da_orig.display_airport_city_name_full orig_city,
    da_orig.distance_km orig_dist_airport_station,
    fw_orig.is_heavy_rain orig_havy_rain,
    fw_orig.is_high_wind orig_high_wind,
    fw_orig.is_freezing orig_freezing,
    fw_orig.precip_mm orig_precip_mm,
    OR(fw_orig.had_thunder, fw_orig.had_fog, fw_orig.had_icing) as orig_other_weather_issue,
    da_dest.display_airport_name dest_airport_name,
    da_dest.display_airport_city_name_full dest_city,
    da_dest.distance_km dest_dist_airport_station,
    fw_dest.is_heavy_rain dest_havy_rain,
    fw_dest.is_high_wind dest_high_wind,
    fw_dest.is_freezing dest_freezing,
    fw_dest.precip_mm dest_precip_mm,
    OR(fw_dest.had_thunder, fw_dest.had_fog, fw_dest.had_icing) as dest_other_weather_issue
FROM AVIATION_WEATHER_PROJECT.DEV.fact_flights ff
LEFT JOIN AVIATION_WEATHER_PROJECT.DEV.dim_airports da_dest
ON ff.DESTAIRPORTID = da_dest.AIRPORT_ID
LEFT JOIN AVIATION_WEATHER_PROJECT.DEV.dim_airports da_orig
ON ff.DESTAIRPORTID = da_orig.AIRPORT_ID
JOIN AVIATION_WEATHER_PROJECT.DEV.fact_weather fw_dest
ON fw_dest.date = ff.date      -- MATCH ON THE WEATHER FOR EACH DATE
AND da_dest.STATION_ID = fw_dest.ID -- ONLY GET WEATHER FROM AIRPORTS WITH CLOSE STATION
JOIN AVIATION_WEATHER_PROJECT.DEV.fact_weather fw_orig
ON fw_orig.date = ff.date      -- MATCH ON THE WEATHER FOR EACH DATE
AND da_orig.STATION_ID = fw_orig.ID -- ONLY GET WEATHER FROM AIRPORTS WITH CLOSE STATION
        );
