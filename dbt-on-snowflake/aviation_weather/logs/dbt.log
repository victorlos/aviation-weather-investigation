ON fw_orig.date = ff.date      -- MATCH ON THE WEATHER FOR EACH DATE
AND da_orig.STATION_ID = fw_orig.ID -- ONLY GET WEATHER FROM AIRPORTS WITH CLOSE STATION
        );
